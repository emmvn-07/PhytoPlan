# Copy this file to .env.local and fill in values from
# Supabase Dashboard -> Project Settings -> API (or "Connect" -> Mobile -> Expo).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key. NEVER put the secret / service_role key here.
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-or-anon-key
