# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# generated native folders (Continuous Native Generation — rebuilt from app.json)
/ios
/android

# Native build output & signing credentials
.kotlin/
*.orig.*
*.jks
*.keystore
!debug.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.pem
*.apk
*.aab
*.ipa
# EAS local credentials
credentials.json

# Metro
.metro-health-check*

# Environment variables — keep secrets out of git; only the template is committed
.env
.env.*
!.env.example

# Supabase CLI local state
supabase/.branches/
supabase/.temp/
supabase/.env

# logs & debug
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# testing
coverage/

# typescript
*.tsbuildinfo

# editors (shared .vscode/ settings and extensions stay tracked)
.idea/
*.swp

# Claude Code: shared .claude/settings.json is tracked; personal settings are not
.claude/settings.local.json

# OS files
.DS_Store
Thumbs.db
Desktop.ini
